  {
    "name": "generate_ideas",
    "title": "Generate content ideas with AI",
    "description": "Generate content ideas with Pixalera AI (costs Pixalera AI credits). Only call when the user wants Pixalera to generate them; you can write ideas yourself for free and save them with create_idea.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "topic": {
          "type": "string",
          "maxLength": 300,
          "description": "Topic, niche or campaign angle."
        },
        "platform": {
          "type": "string",
          "description": "Primary platform, e.g. 'instagram'."
        },
        "audience": {
          "type": "string",
          "maxLength": 200,
          "description": "Who the content is for."
        },
        "tone": {
          "type": "string",
          "maxLength": 100,
          "description": "Desired tone of voice."
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "How many ideas (default 5)."
        },
        "save_to_board": {
          "type": "boolean",
          "description": "Save the generated ideas to the ideas board. Default false."
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": true
    }
  },
  {
    "name": "convert_idea_to_post",
    "title": "Turn an idea into a post",
