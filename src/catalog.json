    "inputSchema": {
      "type": "object",
      "properties": {
        "idea_id": {
          "type": "string"
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "description": "Platforms to post to. Defaults to the idea's own platforms."
        },
        "caption": {
          "type": "string",
          "maxLength": 5000,
          "description": "Override caption. Defaults to the idea's title + details."
        },
        "schedule_mode": {
          "type": "string",
          "enum": [
            "draft",
            "time",
            "next_available",
            "prioritize"
          ],
          "description": "Default draft."
        },
        "scheduled_at": {
          "type": "string",
          "description": "ISO datetime for schedule_mode \"time\"."
        }
      },
      "required": [
        "idea_id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
