  {
    "name": "list_posts",
    "title": "List posts",
    "description": "List this account's posts — drafts, scheduled and published — with caption, platforms, status and schedule time.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "scheduled",
            "published",
            "failed",
            "all"
          ],
          "description": "Filter by post status. Defaults to all."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "description": "How many posts to return (default 20)."
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "create_post",
    "title": "Create a post",
    "description": "Create a draft, queued, scheduled or immediately published post. Supports every field of the Pixalera composer: media, thumbnail, tags, first comment, post type, SEO fields, auto-DM and platform-specific options.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "caption": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000,
          "description": "Post caption / copy."
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "string"
          },
          "description": "Target platforms, e.g. ['instagram','facebook']. Must already be connected."
        },
        "media_urls": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string"
          },
          "description": "Optional public media URLs (https only)."
        },
        "thumbnail_url": {
          "type": "string",
          "description": "Optional custom thumbnail / cover image URL (video, Reels, YouTube)."
        },
        "media_type": {
          "type": "string",
          "enum": [
            "image",
            "video",
            "text"
          ],
          "description": "Media kind. Defaults to image when media_urls are given, else text."
        },
        "post_type": {
          "type": "string",
          "enum": [
            "post",
            "reel",
            "story",
            "short",
            "video"
          ],
          "description": "Composer post type. Default post."
        },
        "tags": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string"
          },
          "description": "Hashtags / tags without the # sign."
        },
        "first_comment": {
          "type": "string",
          "maxLength": 2200,
          "description": "Optional first comment (Instagram / Facebook)."
        },
        "seo_title": {
          "type": "string",
          "maxLength": 200,
          "description": "Title / SEO title (YouTube, Pinterest, blog)."
        },
        "seo_desc": {
          "type": "string",
          "maxLength": 5000,
          "description": "Description / SEO description (YouTube, Pinterest, blog)."
        },
        "auto_dm": {
          "type": "boolean",
          "description": "Turn on the AutoDM trigger for this post."
        },
        "notify_mode": {
          "type": "string",
          "enum": [
            "automatic",
            "notify"
          ],
          "description": "automatic = Pixalera publishes; notify = remind the user instead."
        },
        "platform_options": {
          "type": "object",
          "description": "Platform-specific composer options, keyed by platform, e.g. {\"instagram\":{\"share_to_feed\":true,\"collaborators\":[\"@handle\"],\"location\":\"Delhi\"},\"youtube\":{\"privacy\":\"public\",\"playlist\":\"Shorts\",\"made_for_kids\":false},\"linkedin\":{\"visibility\":\"PUBLIC\"},\"pinterest\":{\"board\":\"Marketing\",\"link\":\"https://...\"},\"x\":{\"thread\":[\"part 2\"]}}",
          "additionalProperties": true
        },
        "schedule_mode": {
          "type": "string",
          "enum": [
            "draft",
            "time",
            "next_available",
            "prioritize",
            "publish_now"
          ],
          "description": "draft = save only; time = use scheduled_at; next_available = first free slot in the channel schedule / queue; prioritize = front of the queue; publish_now = post immediately."
        },
        "scheduled_at": {
          "type": "string",
          "description": "ISO datetime with offset. Used with schedule_mode \"time\" (or on its own)."
        },
        "publish_now": {
          "type": "boolean",
          "description": "Deprecated alias for schedule_mode \"publish_now\". Ask the user for confirmation first."
        }
      },
      "required": [
        "caption",
        "platforms"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": true
    }
  },
  {
    "name": "publish_post_now",
    "title": "Publish a post now",
    "description": "Publish an existing draft or scheduled post immediately to all of its selected platforms. Confirm with the user before calling — this posts publicly right away.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "post_id": {
          "type": "string",
          "description": "The post id returned by list_posts or create_post."
        }
      },
      "required": [
        "post_id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true
    }
  },
  {
    "name": "schedule_post",
    "title": "Schedule an existing post",
    "description": "Schedule a draft/scheduled post. Use mode \"time\" for an exact moment, \"next_available\" for the first free slot in the channel schedule or queue, or \"prioritize\" to put it at the front of the queue (shifting later posts).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "post_id": {
          "type": "string",
          "description": "The post id returned by list_posts."
        },
        "mode": {
          "type": "string",
          "enum": [
            "time",
            "next_available",
            "prioritize"
          ],
          "description": "Default time."
        },
        "scheduled_at": {
          "type": "string",
          "description": "ISO datetime with offset, in the future (e.g. 2026-09-15T18:30:00+05:30). Required for mode \"time\"."
        }
      },
      "required": [
        "post_id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "get_queue",
    "title": "Get the publishing queue",
    "description": "List upcoming scheduled posts in order, plus the next available slot Pixalera would pick for a given platform.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "platform": {
          "type": "string",
          "description": "Optional platform used to compute the next available slot, e.g. 'instagram'."
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "unschedule_post",
    "title": "Cancel a schedule",
    "description": "Move a scheduled post back to draft so it will not publish automatically.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "post_id": {
          "type": "string"
        }
      },
      "required": [
        "post_id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
